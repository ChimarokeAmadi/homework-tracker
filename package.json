{
  "name": "homework-tracker",
  "version": "0.1.0",
  "description": "A small command-line app to keep track of homework.",
  "type": "module",
  "bin": {
    "homework": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90",
    "smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm test && npm run smoke"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "files": [
    "src"
  ]
}
